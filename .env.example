NODE_ENV=development
PORT=3000

# Database (Neon Serverless Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/db

# Redis. Upstash requires TLS: use the rediss:// URL from the Upstash console
# (redis:// is auto-upgraded, but set rediss:// explicitly). Never use REST tokens.
REDIS_URL=redis://localhost:6379

# Stellar / Soroban
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Wallet factory deployed from wallet-contracts (testnet)
FACTORY_CONTRACT_ID=CCCAMWJOF7IYTVCU7SR6HFTNH5XRMDMWPYN464NY5BCKUPMUM64RZ5CH
# Native XLM Stellar Asset Contract (testnet)
NATIVE_TOKEN_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Relay sponsor account. Pays every fee, deploys wallets and funds the testnet
# faucet. Generate with `stellar keys generate relay-sponsor --network testnet`
# and paste the S... secret. The account is auto-funded from Friendbot on testnet.
RELAY_SECRET_KEY=
RELAY_FAUCET_XLM=100
RELAY_MIN_BALANCE_XLM=500

# WebAuthn. RP ID = registrable domain of the web app; ORIGIN = full origin(s),
# comma-separated. The mobile app uses the same RP ID via its associated domain.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Browser origins allowed to call the API (comma-separated). WEBAUTHN_ORIGIN is
# always allowed too.
CORS_ORIGINS=http://localhost:3000

# Optional: Launchtube fee-bump fallback when RELAY_SECRET_KEY is not set
LAUNCHTUBE_API_KEY=

# Notifications
RESEND_API_KEY=
